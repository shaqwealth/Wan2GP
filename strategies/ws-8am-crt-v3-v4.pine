//@version=6
strategy("ws-8AM CRT V3/V4 (Funded algo - 5m)", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=100000, currency=currency.USD, max_lines_count=500, max_labels_count=500, max_boxes_count=500)
// ---------------- Inputs ----------------
sessionRange   = input.session("0800-0900", "Range session", group="Range")
sessionTZ      = input.string("America/New_York", "Session timezone", group="Range")
qtyV3          = input.int(1, "V3 order size (contracts)", minval=1, group="Risk")
tpTicks        = input.int(450, "Take profit (ticks)", minval=1, group="Risk")
slTicks        = input.int(450, "Stop loss (ticks)", minval=1, group="Risk")
oneTradePerDay = input.bool(true, "One trade per day", group="Risk")
cutoffHour     = input.int(11, "No new entries after (hour, session tz)", minval=0, maxval=23, group="Risk")
cutoffMinute   = input.int(0, "No new entries after (minute)", minval=0, maxval=59, group="Risk")
useTimeExit    = input.bool(false, "Close any open trade at a fixed time", group="Risk")
exitHour       = input.int(16, "Close time (hour, session tz)", minval=0, maxval=23, group="Risk")
exitMinute     = input.int(0, "Close time (minute)", minval=0, maxval=59, group="Risk")
enableV4       = input.bool(true, "Enable V4 reversal after V3 stop loss", group="V4 Reversal")
qtyV4          = input.int(1, "V4 order size (contracts)", minval=1, group="V4 Reversal")
tpTicksV4      = input.int(300, "V4 Take profit (ticks)", minval=1, group="V4 Reversal")
slTicksV4      = input.int(200, "V4 Stop loss (ticks)", minval=1, group="V4 Reversal")
showRange      = input.bool(true, "Show range box", group="Display")
rangeLineColor = input.color(color.gray, "Range line color", group="Display")
rangeLineWidth = input.int(1, "Range line width", minval=1, maxval=4, group="Display")
entryLineColor = input.color(color.gray, "Entry line color", group="Display")
tpLineColor    = input.color(color.green, "TP line color", group="Display")
slLineColor    = input.color(color.red, "SL line color", group="Display")
tpFillColor    = input.color(color.new(color.green, 85), "Entry→TP highlight color", group="Display")
slFillColor    = input.color(color.new(color.red, 85), "Entry→SL highlight color", group="Display")
tradeLineWidth = input.int(1, "Entry/TP/SL line width", minval=1, maxval=4, group="Display")
dashV4         = input.bool(true, "Dashed entry/TP/SL lines for V4 trades", group="Display")
showExitLabels = input.bool(true, "Show exit labels (TP/SL)", group="Display")
tpLabelColor   = input.color(color.green, "TP exit label color", group="Display")
slLabelColor   = input.color(color.red, "SL exit label color", group="Display")
tpDist   = tpTicks * syminfo.mintick
slDist   = slTicks * syminfo.mintick
tpDistV4 = tpTicksV4 * syminfo.mintick
slDistV4 = slTicksV4 * syminfo.mintick
// ---------------- Session tracking ----------------
inSession = not na(time(timeframe.period, sessionRange, sessionTZ))
newDay    = ta.change(time("D", sessionTZ)) != 0
var float rangeHigh      = na
var float rangeLow       = na
var bool  rangeReady     = false
var bool  firstBreakUp   = false
var bool  firstBreakDown = false
var bool  tradeTakenToday = false
var box   rangeBox = na
var line  hiLine   = na
var line  loLine   = na
if newDay
    rangeHigh := na
    rangeLow := na
    rangeReady := false
    firstBreakUp := false
    firstBreakDown := false
    tradeTakenToday := false
if inSession
    rangeHigh := na(rangeHigh) ? high : math.max(rangeHigh, high)
    rangeLow  := na(rangeLow)  ? low  : math.min(rangeLow, low)
sessionJustEnded = inSession[1] and not inSession
if sessionJustEnded and not na(rangeHigh) and not na(rangeLow)
    rangeReady := true
    if showRange
        rangeBox := box.new(bar_index, rangeHigh, bar_index, rangeLow, border_color=rangeLineColor, bgcolor=color.new(rangeLineColor, 90), extend=extend.right)
        hiLine := line.new(bar_index, rangeHigh, bar_index, rangeHigh, color=rangeLineColor, width=rangeLineWidth, extend=extend.right)
        loLine := line.new(bar_index, rangeLow, bar_index, rangeLow, color=rangeLineColor, width=rangeLineWidth, extend=extend.right)
// ---------------- Breakout / reversal detection ----------------
beforeCutoff = (hour(time, sessionTZ) * 60 + minute(time, sessionTZ)) < (cutoffHour * 60 + cutoffMinute)
canTrade = (not oneTradePerDay or not tradeTakenToday) and beforeCutoff
if rangeReady and not inSession
    breakUp   = close > rangeHigh
    breakDown = close < rangeLow
    if not firstBreakUp and not firstBreakDown
        if breakUp
            firstBreakUp := true
        else if breakDown
            firstBreakDown := true
    longCond  = firstBreakDown and breakUp   and canTrade
    shortCond = firstBreakUp   and breakDown and canTrade
    if longCond
        strategy.entry("Long", strategy.long, qty=qtyV3)
        // bracket goes in with the entry so it is live on the fill bar itself; profit/loss
        // are in ticks off the fill price, so they need no reference to the open position.
        strategy.exit("Long Exit", "Long", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")
        tradeTakenToday := true
        firstBreakDown := false
        firstBreakUp := true
    if shortCond
        strategy.entry("Short", strategy.short, qty=qtyV3)
        strategy.exit("Short Exit", "Short", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")
        tradeTakenToday := true
        firstBreakUp := false
        firstBreakDown := true
// ---------------- V4: opposite-direction trade fired when a V3 trade exits on its stop loss ----------------
// counting closed trades (rather than watching position_size[1]) also catches a trade
// that entered and hit its stop inside a single bar, which never shows a non-flat prior bar.
tradeJustClosed = strategy.position_size == 0 and strategy.closedtrades > nz(strategy.closedtrades[1])
if enableV4 and tradeJustClosed
    // comment_profit/comment_loss below tag each exit, so we can tell a stop-loss exit
    // apart from a take-profit exit and only reverse on the former.
    lastNum         = strategy.closedtrades - 1
    lastEntryId     = strategy.closedtrades.entry_id(lastNum)
    lastExitComment = strategy.closedtrades.exit_comment(lastNum)
    if lastExitComment == "SL"
        if lastEntryId == "Long"
            strategy.entry("V4 Short", strategy.short, qty=qtyV4)
            strategy.exit("V4 Short Exit", "V4 Short", profit=tpTicksV4, loss=slTicksV4, comment_profit="TP", comment_loss="SL")
        else if lastEntryId == "Short"
            strategy.entry("V4 Long", strategy.long, qty=qtyV4)
            strategy.exit("V4 Long Exit", "V4 Long", profit=tpTicksV4, loss=slTicksV4, comment_profit="TP", comment_loss="SL")
// ---------------- Time-based flat ----------------
// Without this a trade sits open until TP or SL is touched, which on a wide bracket can
// span several sessions. Off by default so it does not silently change existing results.
timeToFlat = useTimeExit and (hour(time, sessionTZ) * 60 + minute(time, sessionTZ)) >= (exitHour * 60 + exitMinute)
if timeToFlat and strategy.position_size != 0
    // "EOD" (not "SL") so a timed close never arms the V4 reversal.
    strategy.close_all(comment="EOD")
// ---------------- Exits: fixed TP/SL in ticks off the average fill ----------------
// entry/TP/SL lines + filled highlight zones (no text labels)
var line     entryLine = na
var line     tpLine    = na
var line     slLine    = na
var linefill tpFill    = na
var linefill slFill    = na
// entry bar of the trade the lines above belong to. Keying the redraw on it means a new
// trade always gets its own lines, even if the reset in the closing branch was missed.
var int      drawnBar  = na
if strategy.position_size != 0
    entryBar   = strategy.opentrades.entry_bar_index(0)
    entryPrice = strategy.opentrades.entry_price(0)
    entryId    = strategy.opentrades.entry_id(0)
    isV4       = entryId == "V4 Long" or entryId == "V4 Short"
    isLong     = strategy.position_size > 0
    curTpDist  = isV4 ? tpDistV4 : tpDist
    curSlDist  = isV4 ? slDistV4 : slDist
    tp = isLong ? entryPrice + curTpDist : entryPrice - curTpDist
    sl = isLong ? entryPrice - curSlDist : entryPrice + curSlDist
    lineStyle = isV4 and dashV4 ? line.style_dashed : line.style_solid
    if na(entryLine) or nz(drawnBar, -1) != entryBar
        drawnBar  := entryBar
        entryLine := line.new(entryBar, entryPrice, bar_index, entryPrice, color=entryLineColor, width=tradeLineWidth, style=lineStyle)
        tpLine    := line.new(entryBar, tp,          bar_index, tp,          color=tpLineColor, width=tradeLineWidth, style=lineStyle)
        slLine    := line.new(entryBar, sl,          bar_index, sl,          color=slLineColor, width=tradeLineWidth, style=lineStyle)
        tpFill    := linefill.new(entryLine, tpLine, color=tpFillColor)
        slFill    := linefill.new(entryLine, slLine, color=slFillColor)
    else
        line.set_x2(entryLine, bar_index)
        line.set_x2(tpLine, bar_index)
        line.set_x2(slLine, bar_index)
    // same order id as the bracket sent with the entry, so this refreshes it rather than
    // adding a second one. No qty: the exit closes whatever size the entry filled, V3 or V4.
    curTp = isV4 ? tpTicksV4 : tpTicks
    curSl = isV4 ? slTicksV4 : slTicks
    strategy.exit(entryId + " Exit", entryId, profit=curTp, loss=curSl, comment_profit="TP", comment_loss="SL")
else
    if tradeJustClosed
        // A stop/limit fill is applied before this bar's script logic runs, so by the time we
        // get here strategy.position_size is already 0 on the very bar the trade exited. Without
        // this branch the lines/highlight would freeze one bar early and never show the exit.
        lastNum    = strategy.closedtrades - 1
        entryBar   = strategy.closedtrades.entry_bar_index(lastNum)
        entryPrice = strategy.closedtrades.entry_price(lastNum)
        entryId    = strategy.closedtrades.entry_id(lastNum)
        exitBar    = strategy.closedtrades.exit_bar_index(lastNum)
        exitPrice  = strategy.closedtrades.exit_price(lastNum)
        exitReason = strategy.closedtrades.exit_comment(lastNum)
        isV4       = entryId == "V4 Long" or entryId == "V4 Short"
        isLong     = strategy.closedtrades.size(lastNum) > 0
        tp = isLong ? entryPrice + (isV4 ? tpDistV4 : tpDist) : entryPrice - (isV4 ? tpDistV4 : tpDist)
        sl = isLong ? entryPrice - (isV4 ? slDistV4 : slDist) : entryPrice + (isV4 ? slDistV4 : slDist)
        lineStyle = isV4 and dashV4 ? line.style_dashed : line.style_solid
        if na(entryLine) or nz(drawnBar, -1) != entryBar
            // entry and exit landed on the same bar, so the block above never ran for this
            // trade: draw the whole picture here from the closed-trade record.
            drawnBar  := entryBar
            entryLine := line.new(entryBar, entryPrice, exitBar, entryPrice, color=entryLineColor, width=tradeLineWidth, style=lineStyle)
            tpLine    := line.new(entryBar, tp,         exitBar, tp,         color=tpLineColor, width=tradeLineWidth, style=lineStyle)
            slLine    := line.new(entryBar, sl,         exitBar, sl,         color=slLineColor, width=tradeLineWidth, style=lineStyle)
            tpFill    := linefill.new(entryLine, tpLine, color=tpFillColor)
            slFill    := linefill.new(entryLine, slLine, color=slFillColor)
        else
            line.set_x2(entryLine, exitBar)
            line.set_x2(tpLine, exitBar)
            line.set_x2(slLine, exitBar)
        if showExitLabels
            isWin = exitReason == "TP"
            label.new(exitBar, exitPrice, exitReason, style=isWin ? label.style_label_down : label.style_label_up, color=isWin ? tpLabelColor : slLabelColor, textcolor=color.white, size=size.small)
        // trade closed: stop tracking so the next trade starts fresh lines.
        // previously drawn lines/fills are left on the chart as history.
        entryLine := na
        tpLine    := na
        slLine    := na
        tpFill    := na
        slFill    := na
plot(rangeReady ? rangeHigh : na, "Range High", color=rangeLineColor, style=plot.style_linebr)
plot(rangeReady ? rangeLow : na, "Range Low", color=rangeLineColor, style=plot.style_linebr)
