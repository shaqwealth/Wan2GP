// Range Break Reversal (8-9AM America/New_York)
//
// Logic:
//   1. Build a range from the high/low printed during the 08:00-09:00
//      America/New_York session.
//   2. After the range closes, wait for the first breakout (close beyond
//      the range high OR the range low).
//   3. If price then breaks back through the OPPOSITE side of the range,
//      treat the first breakout as a fakeout/liquidity sweep and enter in
//      the direction of the second (reversal) breakout.
//   4. Stop-loss sits at the low (long) / high (short) of the candle that
//      triggers the entry, with a minimum distance in ticks: if that
//      candle is too small (e.g. its wick is only 140 ticks away), the
//      stop is pushed out to the minimum (e.g. 200 ticks) instead.
//   5. Take-profit is the high (long) / low (short) of the most recently
//      completed Asian session. A trade is skipped if that level has
//      already been passed, since it would no longer be a valid target.
//   6. No new entries after 11:00 (session timezone) by default; trades
//      already open keep running to their TP/SL.
//
// Import this file's content into a new Pine script on TradingView
// (Pine Editor > New > paste), or drag-and-drop the .pine file if your
// setup supports it, then add the strategy to a chart.

//@version=5
strategy("Range Break Reversal (8-9AM NY)", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=100000, currency=currency.USD)

// ---------------- Inputs ----------------
sessionRange   = input.session("0800-0900", "Range session", group="Range")
sessionTZ      = input.string("America/New_York", "Session timezone", group="Range")
asiaSessionStr = input.session("1700-0400", "Asian session (TP reference)", group="Take Profit")
minSlTicks     = input.int(200, "Minimum stop distance (ticks)", minval=1, group="Risk")
oneTradePerDay = input.bool(true, "One trade per day", group="Risk")
cutoffHour     = input.int(11, "No new entries after (hour, session tz)", minval=0, maxval=23, group="Risk")
cutoffMinute   = input.int(0, "No new entries after (minute)", minval=0, maxval=59, group="Risk")
showRange      = input.bool(true, "Show range box", group="Display")
showAsiaLevels = input.bool(true, "Show Asian high/low", group="Display")

minSlDist = minSlTicks * syminfo.mintick

// ---------------- NY range tracking (08:00-09:00) ----------------
inSession = not na(time(timeframe.period, sessionRange, sessionTZ))
newDay    = ta.change(time("D", sessionTZ))

var float rangeHigh       = na
var float rangeLow        = na
var bool  rangeReady      = false
var bool  firstBreakUp    = false
var bool  firstBreakDown  = false
var bool  tradeTakenToday = false
var float slCandleLow     = na
var float slCandleHigh    = na
var box   rangeBox = na
var line  hiLine   = na
var line  loLine   = na

if newDay
    rangeHigh := na
    rangeLow := na
    rangeReady := false
    firstBreakUp := false
    firstBreakDown := false
    tradeTakenToday := false

if inSession
    rangeHigh := na(rangeHigh) ? high : math.max(rangeHigh, high)
    rangeLow  := na(rangeLow)  ? low  : math.min(rangeLow, low)

sessionJustEnded = inSession[1] and not inSession
if sessionJustEnded and not na(rangeHigh) and not na(rangeLow)
    rangeReady := true
    if showRange
        rangeBox := box.new(bar_index, rangeHigh, bar_index, rangeLow,
             border_color=color.gray, bgcolor=color.new(color.gray, 90), extend=extend.right)
        hiLine := line.new(bar_index, rangeHigh, bar_index, rangeHigh, color=color.gray, extend=extend.right)
        loLine := line.new(bar_index, rangeLow, bar_index, rangeLow, color=color.gray, extend=extend.right)

// ---------------- Asian session high/low (most recently completed) ----------------
is_newbar(sess) =>
    t = time("D", sess, sessionTZ)
    na(t[1]) and not na(t) or t[1] < t

is_session(sess) =>
    not na(time("D", sess, sessionTZ))

asiaSessionActive = is_session(asiaSessionStr)
asiaNewbar = is_newbar(asiaSessionStr)

var float asiaHighAccum = na
var float asiaLowAccum  = na
var float lastAsiaHigh  = na
var float lastAsiaLow   = na

if asiaSessionActive
    asiaHighAccum := asiaNewbar ? high : math.max(asiaHighAccum, high)
    asiaLowAccum  := asiaNewbar ? low  : math.min(asiaLowAccum, low)

asiaJustEnded = asiaSessionActive[1] and not asiaSessionActive
if asiaJustEnded
    lastAsiaHigh := asiaHighAccum
    lastAsiaLow := asiaLowAccum
    asiaHighAccum := na
    asiaLowAccum := na

plot(showAsiaLevels ? lastAsiaHigh : na, "Asia High", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(showAsiaLevels ? lastAsiaLow : na, "Asia Low", color=color.new(color.orange, 0), style=plot.style_linebr)

// ---------------- Breakout / reversal detection ----------------
beforeCutoff = (hour(time, sessionTZ) * 60 + minute(time, sessionTZ)) < (cutoffHour * 60 + cutoffMinute)
canTrade = (not oneTradePerDay or not tradeTakenToday) and beforeCutoff

if rangeReady and not inSession
    breakUp   = close > rangeHigh
    breakDown = close < rangeLow

    if not firstBreakUp and not firstBreakDown
        if breakUp
            firstBreakUp := true
        else if breakDown
            firstBreakDown := true

    validLongTarget  = not na(lastAsiaHigh) and lastAsiaHigh > close
    validShortTarget = not na(lastAsiaLow)  and lastAsiaLow  < close

    longCond  = firstBreakDown and breakUp   and canTrade and validLongTarget
    shortCond = firstBreakUp   and breakDown and canTrade and validShortTarget

    if longCond
        slCandleLow := low
        strategy.entry("Long", strategy.long)
        tradeTakenToday := true
        firstBreakDown := false
        firstBreakUp := true

    if shortCond
        slCandleHigh := high
        strategy.entry("Short", strategy.short)
        tradeTakenToday := true
        firstBreakUp := false
        firstBreakDown := true

// ---------------- Exits: candle-based stop (with min distance) + Asia high/low target ----------------
if strategy.position_size > 0
    stopPrice = math.min(slCandleLow, strategy.position_avg_price - minSlDist)
    strategy.exit("Long Exit", "Long", limit=lastAsiaHigh, stop=stopPrice)

if strategy.position_size < 0
    stopPrice = math.max(slCandleHigh, strategy.position_avg_price + minSlDist)
    strategy.exit("Short Exit", "Short", limit=lastAsiaLow, stop=stopPrice)

plot(rangeReady ? rangeHigh : na, "Range High", color=color.new(color.gray, 0), style=plot.style_linebr)
plot(rangeReady ? rangeLow : na, "Range Low", color=color.new(color.gray, 0), style=plot.style_linebr)
