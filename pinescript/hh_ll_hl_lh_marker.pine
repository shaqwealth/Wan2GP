//@version=5
strategy("HH LL HL LH Marker", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1, calc_on_every_tick = true, max_lines_count = 500, max_boxes_count = 500)

// Importing Libarary
import TradingView/ZigZag/7 as ZigZagLib

//Input
lb=input(5,"Left Bars")
rb=input(5,"Right Bars")

showhh=input(true,"HigherHigh")
showhl=input(true,"HigherLow")
showlh=input(true,"LowerHigh")
showll=input(true,"LowerLow")

//Trade Input
tradehh = input(true, "Trade on HigherHigh (Short)", group="Trade Setup")
tradehl = input(true, "Trade on HigherLow (Long)", group="Trade Setup")
tradelh = input(true, "Trade on LowerHigh (Short)", group="Trade Setup")
tradell = input(true, "Trade on LowerLow (Long)", group="Trade Setup")
tpTicks = input.int(152, "Take Profit (ticks)", group="Trade Setup")
slTicks = input.int(100, "Stop Loss (ticks)", group="Trade Setup")

entryLineColor = input.color(color.gray, "Entry Line Color", group="Trade Setup")
tpZoneColor = input.color(color.blue, "Take Profit Zone Color", group="Trade Setup")
slZoneColor = input.color(color.red, "Stop Loss Zone Color", group="Trade Setup")

//Define Pivot points
ph=ta.pivothigh(lb,rb)
pl=ta.pivotlow(lb,rb)

//Define Pivot Direction and assign ZigZag Point
hl = not na(ph) ? 1 : (not na(pl) ? -1 : na)
zz= not na(ph) ? ph : (not na(pl) ? pl : na)
zz := not na(pl) and hl == -1 and ta.valuewhen(not na(hl), hl, 1) == -1 and ph > ta.valuewhen(not na(zz), zz, 1)? na : zz
zz := not na(ph) and hl == 1 and ta.valuewhen(not na(hl), hl, 1) == 1 and pl < ta.valuewhen(not na(zz), zz, 1)? na : zz

hl := hl == 1 and ta.valuewhen(not na(hl), hl, 1) == -1 and zz < ta.valuewhen(not na(zz), zz, 1)? na : hl
hl := hl == -1 and ta.valuewhen(not na(hl), hl, 1) == 1 and zz > ta.valuewhen(not na(zz), zz, 1)? na : hl
zz := na(hl)? na: zz

//@function to Find previous 4 zigzag points
findprevious()=>
    ehl = hl==1? -1: 1
    loc1 = 0.0, loc2 = 0.0, loc3 = 0.0, loc4 = 0.0
    xx = 0
    for x=1 to 1000
        if hl[x]==ehl and not na(zz[x])
            loc1 := zz[x]
            xx := x + 1
            break
    ehl := hl
    for x=xx to 1000
        if hl[x]==ehl and not na(zz[x])
            loc2 := zz[x]
            xx := x + 1
            break
    ehl := hl==1? -1: 1
    for x=xx to 1000
        if hl[x]==ehl and not na(zz[x])
            loc3 := zz[x]
            xx := x + 1
            break
    ehl := hl
    for x=xx to 1000
        if hl[x]==ehl and not na(zz[x])
            loc4 := zz[x]
            break
    [loc1, loc2, loc3, loc4]

//Copy Previous Zigzag points
float a = na, float b = na, float c = na, float d = na, float e = na
[loc1, loc2, loc3, loc4] = findprevious()
a := zz
b := loc1
c := loc2
d := loc3
e := loc4

//@ Condition to evaluate current ZigZag Points
_hh = not na(zz) and (a > b and a > c and c > b and c > d) and not na(hl)
_ll = not na(zz) and (a < b and a < c and c < b and c < d) and not na(hl)
_hl = not na(zz) and ((a >= c and (b > c and b > d and d > c and d > e)) or (a < b and a > c and b < d)) and not na(hl)
_lh = not na(zz) and ((a <= c and (b < c and b < d and d < c and d < e)) or (a > b and a < c and b > d)) and not na(hl)



//Plot ZigZag Points
plotshape(showhl and _hl ? _hl : na, text="HL", title="Higher Low", style=shape.labelup, color=color.lime, textcolor=color.black, location=location.belowbar, offset=-rb)
plotshape(showhh and _hh ? _hh : na, text="HH", title="Higher High", style=shape.labeldown, color=color.lime, textcolor=color.black, location=location.abovebar, offset=-rb)
plotshape(showll and _ll ? _ll : na, text="LL", title="Lower Low", style=shape.labelup, color=color.red, textcolor=color.white, location=location.belowbar, offset=-rb)
plotshape(showlh and _lh ? _lh : na, text="LH", title="Lower High", style=shape.labeldown, color=color.red, textcolor=color.white, location=location.abovebar, offset=-rb)

//Enter position when a marker fires, closing any position already en cours first
goLong = (tradehl and showhl and _hl) or (tradell and showll and _ll)
goShort = (tradehh and showhh and _hh) or (tradelh and showlh and _lh)

if goLong or goShort
    strategy.close_all(comment="New Signal")
if goLong
    strategy.entry("Long", strategy.long)
if goShort
    strategy.entry("Short", strategy.short)

strategy.exit("Long TP/SL", from_entry="Long", profit=tpTicks, loss=slTicks)
strategy.exit("Short TP/SL", from_entry="Short", profit=tpTicks, loss=slTicks)

//Draw entry/TP/SL levels for the open trade
var line entryLine = na
var box tpBox = na
var box slBox = na
var bool tradeOpen = false

posSize = strategy.position_size
//Entries fill on the bar after the signal, since the close is queued ahead of them
isNewEntry = goLong[1] or goShort[1]
isExit = posSize == 0 and posSize[1] != 0 and not isNewEntry

freezeLevels() =>
    if tradeOpen
        line.set_x2(entryLine, bar_index)
        line.set_extend(entryLine, extend.none)
        box.set_right(tpBox, bar_index)
        box.set_extend(tpBox, extend.none)
        box.set_right(slBox, bar_index)
        box.set_extend(slBox, extend.none)

if isNewEntry
    freezeLevels()
    entryPrice = strategy.position_avg_price
    isLong = posSize > 0
    tpPrice = isLong ? entryPrice + tpTicks * syminfo.mintick : entryPrice - tpTicks * syminfo.mintick
    slPrice = isLong ? entryPrice - slTicks * syminfo.mintick : entryPrice + slTicks * syminfo.mintick

    entryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color=entryLineColor, width=1, extend=extend.right)
    tpBox := box.new(bar_index, math.max(entryPrice, tpPrice), bar_index, math.min(entryPrice, tpPrice), border_color=na, extend=extend.right, bgcolor=color.new(tpZoneColor, 85))
    slBox := box.new(bar_index, math.max(entryPrice, slPrice), bar_index, math.min(entryPrice, slPrice), border_color=na, extend=extend.right, bgcolor=color.new(slZoneColor, 85))
    tradeOpen := true

if isExit
    freezeLevels()
    tradeOpen := false

// Create Zig Zag instance from user settings.
var zigZag = ZigZagLib.newInstance(
  ZigZagLib.Settings.new(
      input.float(5.0, "Price deviation for reversals (%)", 0.00001, 100.0, 0.5, "0.00001 - 100"),
      input.int(10, "Pivot legs", 2),
      input(color.gray, "Line color", display = display.data_window),
      input(true, "Extend to last bar", display = display.data_window),
      input(false, "Display reversal price", display = display.data_window),
      input(false, "Display cumulative volume", display = display.data_window),
      input(false, "Display reversal price change", inline = "priceRev", display = display.data_window),
      input.string("Absolute", "", ["Absolute", "Percent"], inline = "priceRev", display = display.data_window),
      true)
 )

// Update 'zigZag' object on each bar with new pivots, volume, lines, labels.
zigZag.update()
