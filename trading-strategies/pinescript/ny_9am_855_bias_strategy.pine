//@version=6
strategy("ws-9AM open algo", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false, pyramiding=0, max_lines_count=500)

// Enters once per day at the NY 9:00 AM open, direction set by the 5-minute
// 8:55 AM (America/New_York) candle: bullish -> long, bearish -> short.
// If the 8:55 candle is flat (close == open, no clear bias), the 8:50
// candle is used as the reference instead.
// Trade V2 (optional): if that trade is stopped out, one reversal trade
// is taken with the same TP/SL, once the first confirming candle closes
// (first bearish close to go short after a failed long, first bullish
// close to go long after a failed short). A Doji (tiny body relative to
// its range) never counts as confirmation; the wait continues.
// Trade V3 (optional, independent of V1/V2): builds the 8:00-9:00 AM
// opening range. The first candle body that closes beyond one side of
// the range marks that side as broken. Once a side is broken, the trade
// is taken only when a later candle body closes beyond the OPPOSITE side.
// Run this strategy on the 5-minute chart.

tpTicks   = input.int(300, "Take Profit (ticks)", minval=1, group="Risk")
slTicks   = input.int(200, "Stop Loss (ticks)",   minval=1, group="Risk")
qty       = input.float(1, "Order size", minval=0.01, group="Order")

enableV2       = input.bool(false, "Trade V2: reverse once if stopped out", group="Strategy")
dojiMaxBodyPct = input.float(10.0, "Ignore confirmation candle if body <= X% of range (Doji filter)", minval=0, maxval=100, group="Strategy") / 100
enableV3       = input.bool(false, "Trade V3: opposite-side break of the 8-9am range", group="Strategy")
showDebugLabels = input.bool(true, "Show debug labels (V2 armed / V3 side broken)", group="Strategy")

showLines   = input.bool(true, "Show entry/TP/SL lines", group="Display")
entryColor  = input.color(color.blue,                  "Entry line color",  group="Display")
tpColor     = input.color(color.green,                 "TP line color",     group="Display")
slColor     = input.color(color.red,                   "SL line color",     group="Display")
tpZoneColor = input.color(color.new(color.green, 85),   "Entry->TP zone color", group="Display")
slZoneColor = input.color(color.new(color.red, 85),     "Entry->SL zone color", group="Display")
lineWidth   = input.int(1, "Line width", minval=1, maxval=4, group="Display")
lineStyleIn = input.string("Dashed", "TP/SL line style", options=["Solid", "Dashed", "Dotted"], group="Display")

lineStyle = lineStyleIn == "Solid" ? line.style_solid : lineStyleIn == "Dotted" ? line.style_dotted : line.style_dashed

tz = "America/New_York"
nyHour   = hour(time, tz)
nyMinute = minute(time, tz)
nyDay    = dayofmonth(time, tz)

is0855Bar = nyHour == 8 and nyMinute == 55

var bool   tradedToday   = false
var bool   v2Used        = false
var bool   v2Pending     = false
var float  v2PendingDir  = na
var float  lastTradeDir  = na
var int    lastDay = na
var bool   tradedV3Today = false
var string v3BrokenSide  = na
var float  rangeHigh     = na
var float  rangeLow      = na

if na(lastDay) or nyDay != lastDay
    lastDay := nyDay
    tradedToday := false
    v2Used := false
    v2Pending := false
    tradedV3Today := false
    v3BrokenSide := na
    rangeHigh := na
    rangeLow := na

// --- Trade V3: build the 8:00-9:00 AM opening range ---
if enableV3 and nyHour == 8
    rangeHigh := na(rangeHigh) ? high : math.max(rangeHigh, high)
    rangeLow  := na(rangeLow)  ? low  : math.min(rangeLow, low)

plot(enableV3 and not na(rangeHigh) ? rangeHigh : na, color=color.blue,   style=plot.style_line, title="8-9am Range High")
plot(enableV3 and not na(rangeLow)  ? rangeLow  : na, color=color.orange, style=plot.style_line, title="8-9am Range Low")

if is0855Bar and not tradedToday
    tradedToday := true
    bool bullish = close > open
    bool bearish = close < open
    if not bullish and not bearish
        // 8:55 candle is flat -> fall back to the 8:50 candle
        bullish := close[1] > open[1]
        bearish := close[1] < open[1]

    if bullish
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("Long Exit", "Long", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")
        lastTradeDir := 1.0
    else if bearish
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Short Exit", "Short", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")
        lastTradeDir := -1.0

// --- Trade V2: reverse once if the current trade was stopped out ---
// On stop-out, wait for the first confirming candle before reversing:
// first bearish close to go short after a failed long, first bullish
// close to go long after a failed short.
justExited = strategy.position_size == 0 and strategy.position_size[1] != 0

v2JustArmed    = false
v2JustNotArmed = false
var string lastExitComment = na

if enableV2 and justExited and not v2Used and strategy.closedtrades > 0
    lastExitComment := strategy.closedtrades.exit_comment(strategy.closedtrades - 1)
    if lastExitComment == "SL"
        v2Used := true
        v2Pending := true
        v2PendingDir := lastTradeDir == 1.0 ? -1.0 : 1.0
        v2JustArmed := true
    else
        v2JustNotArmed := true

if showDebugLabels and v2JustArmed
    label.new(bar_index, high, "V2 armed\nwaiting for " + (v2PendingDir == 1.0 ? "bullish" : "bearish") + " close", color=color.purple, style=label.style_label_down, textcolor=color.white, size=size.small)

if showDebugLabels and v2JustNotArmed
    label.new(bar_index, low, "Exit: " + lastExitComment, color=color.gray, style=label.style_label_up, textcolor=color.white, size=size.tiny)

if v2Pending
    float candleRange = high - low
    bool  isDoji       = candleRange > 0 and (math.abs(close - open) / candleRange) <= dojiMaxBodyPct
    bool  candleBullish = close > open and not isDoji
    bool  candleBearish = close < open and not isDoji
    if v2PendingDir == -1.0 and candleBearish
        v2Pending := false
        strategy.entry("Short V2", strategy.short, qty=qty)
        strategy.exit("Short V2 Exit", "Short V2", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")
        lastTradeDir := -1.0
    else if v2PendingDir == 1.0 and candleBullish
        v2Pending := false
        strategy.entry("Long V2", strategy.long, qty=qty)
        strategy.exit("Long V2 Exit", "Long V2", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")
        lastTradeDir := 1.0

// --- Trade V3: trade the opposite-side break, once one side is already broken ---
canWatchV3 = enableV3 and nyHour != 8 and not na(rangeHigh) and not na(rangeLow) and not tradedV3Today

v3JustBrokeHigh = false
v3JustBrokeLow  = false

if canWatchV3
    if na(v3BrokenSide)
        if close > rangeHigh
            v3BrokenSide := "high"
            v3JustBrokeHigh := true
        else if close < rangeLow
            v3BrokenSide := "low"
            v3JustBrokeLow := true
    else if v3BrokenSide == "high" and close < rangeLow
        tradedV3Today := true
        strategy.entry("Short V3", strategy.short, qty=qty)
        strategy.exit("Short V3 Exit", "Short V3", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")
    else if v3BrokenSide == "low" and close > rangeHigh
        tradedV3Today := true
        strategy.entry("Long V3", strategy.long, qty=qty)
        strategy.exit("Long V3 Exit", "Long V3", profit=tpTicks, loss=slTicks, comment_profit="TP", comment_loss="SL")

if showDebugLabels and v3JustBrokeHigh
    label.new(bar_index, high, "V3: high broken\nwaiting for low break", color=color.blue, style=label.style_label_down, textcolor=color.white, size=size.small)

if showDebugLabels and v3JustBrokeLow
    label.new(bar_index, low, "V3: low broken\nwaiting for high break", color=color.orange, style=label.style_label_up, textcolor=color.white, size=size.small)

// --- Entry / TP / SL lines + shaded zones for the active trade ---
var line     entryLine = na
var line     tpLine    = na
var line     slLine    = na
var linefill tpFill    = na
var linefill slFill    = na

posSizePrev = strategy.position_size[1]
justEntered = strategy.position_size != 0 and (posSizePrev == 0 or math.sign(strategy.position_size) != math.sign(posSizePrev))
inTrade     = strategy.position_size != 0

if showLines and justEntered
    float entryPrice = strategy.position_avg_price
    float dir        = strategy.position_size > 0 ? 1.0 : -1.0
    float tpPrice    = entryPrice + dir * tpTicks * syminfo.mintick
    float slPrice    = entryPrice - dir * slTicks * syminfo.mintick

    entryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color=entryColor, width=lineWidth, style=line.style_solid)
    tpLine    := line.new(bar_index, tpPrice,    bar_index, tpPrice,    color=tpColor,    width=lineWidth, style=lineStyle)
    slLine    := line.new(bar_index, slPrice,    bar_index, slPrice,    color=slColor,    width=lineWidth, style=lineStyle)

    tpFill := linefill.new(entryLine, tpLine, color=tpZoneColor)
    slFill := linefill.new(entryLine, slLine, color=slZoneColor)

if showLines and inTrade and not na(entryLine)
    line.set_x2(entryLine, bar_index)
    line.set_x2(tpLine, bar_index)
    line.set_x2(slLine, bar_index)
